<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.plantidentifier.ui.home.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_analysisFragment"
            app:destination="@id/analysisFragment" />

    </fragment>

    <fragment
        android:id="@+id/analysisFragment"
        android:name="com.example.plantidentifier.ui.analysis.AnalysisFragment"
        android:label="Analysis">

        <argument
            android:name="imagePath"
            app:argType="string" />
        <argument
            android:name="organ"
            android:defaultValue="leaf"
            app:argType="string" />



        <action
            android:id="@+id/action_analysisFragment_to_resultFragment"
            app:destination="@id/resultFragment" />

    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.plantidentifier.ui.result.ResultFragment"
        android:label="Result">

        <argument
            android:name="imagePath"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.plantidentifier.ui.onboarding.OnboardingFragment"
        android:label="Onboarding" />

</navigation>
