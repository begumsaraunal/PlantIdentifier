<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PlantIdentifier" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryGreen</item>
        <item name="colorPrimaryVariant">@color/primaryGreen</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accentGreen</item>
        <item name="colorSecondaryVariant">@color/accentGreen</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:navigationBarColor">@color/appBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Background and surface colors -->
        <item name="android:windowBackground">@color/appBackground</item>
    </style>

    <style name="Theme.PlantIdentifier" parent="Base.Theme.PlantIdentifier" />

    <style name="ThemeOverlay.PlantIdentifier.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/primaryGreen</item>
        <item name="colorSecondary">@color/primaryGreen</item>
        <item name="colorSurface">@color/appSurface</item>
        <item name="colorOnSurface">@color/appText</item>
    </style>

    <style name="Theme.PlantIdentifier.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/appBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_plant</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.PlantIdentifier</item>

    </style>
</resources>
